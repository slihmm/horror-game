{
  "name": "Descent",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "ServerStorage": {
      "Assets": {
        "$className": "Folder",
        "Props": { "$className": "Folder" },
        "Monster": { "$className": "Folder" }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "CameraMinZoomDistance": 0.5,
        "NameDisplayDistance": 0,
        "HealthDisplayDistance": 0,
        "EnableMouseLockOption": false,
        "CharacterWalkSpeed": 9,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 4,
        "AutoJumpEnabled": false,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" },
        "RbxCharacterSounds": { "$path": "src/overrides/RbxCharacterSounds.client.luau" }
      },
      "StarterCharacterScripts": {
        "Health": { "$path": "src/overrides/Health.server.luau" }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 6
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Ambient": [0, 0, 0],
        "OutdoorAmbient": [0, 0, 0],
        "Brightness": 0,
        "ClockTime": 0,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0.35,
        "ExposureCompensation": 0,
        "FogColor": [0, 0, 0],
        "FogEnd": 100000
      }
    },
    "SoundService": {
      "$properties": {
        "AmbientReverb": "Cave",
        "RespectFilteringEnabled": true,
        "RolloffScale": 1,
        "DistanceFactor": 3.33
      }
    },
    "TextChatService": {
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": { "Enabled": false }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 384,
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -2000
      }
    }
  }
}
